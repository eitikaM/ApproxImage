# Mode 0
read_verilog verilog/structural_multiplier.v
synth -top structural_multiplier
flatten
opt
abc -g gates
rename -top net_mode0
write_json results/simulator/net_mode0.json

# Mode 1
design -reset
read_verilog verilog/structural_multiplier.v verilog/approximate_multiplier.v verilog/synthesis_mode1.v
synth -top synthesis_mode1
flatten
opt
abc -g gates
rename -top net_mode1
write_json results/simulator/net_mode1.json

